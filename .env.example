# 이 파일을 .env 로 복사한 뒤 실제 값을 넣으세요.
# .env 는 git 에 올라가지 않습니다.
#
# 발급 방법은 docs/setup.md 를 보세요.

# 무더위쉼터 등 — data.go.kr
DATA_GO_KR_KEY=발급받은_공공데이터포털_디코딩_키

# 지진 옥외대피장소 — safetydata.go.kr (다른 사이트라 키도 다르다)
# safetydata.go.kr 는 데이터마다 키가 따로 발급된다.
# 마이페이지 > API키 발급 내역에서 각각 복사해 넣는다.
SAFETYDATA_KEY_EARTHQUAKE=지진옥외대피장소_인증키
SAFETYDATA_KEY_HEAT_COLD=무더위쉼터_인증키
SAFETYDATA_KEY_TEMP_HOUSING=이재민임시주거시설_인증키
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=서비스_롤_키_절대_공개금지
